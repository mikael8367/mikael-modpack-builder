PORT=3000
# API Key da CurseForge para downloads automatizados e resolução de links de projeto.
# Configure como variável secreta no Render. Nunca coloque a chave no frontend.
CURSEFORGE_API_KEY=

# Mirror público compatível com a estrutura REST da CurseForge (MCIM).
CURSEFORGE_PUBLIC_PROXY_URLS=https://mod.mcimirror.top/curseforge
